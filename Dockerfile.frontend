FROM node:18-alpine as build

WORKDIR /app

# Debug: list build context
RUN pwd && ls -la

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code (from front directory context)
COPY . .

# Debug: check if utils.ts exists
RUN echo "=== Checking lib directory ===" && (ls -la /app/src/lib/ 2>/dev/null && echo "lib directory exists") || echo "lib directory not found" && echo "=== Finding utils.ts ===" && (find /app -name "utils.ts" 2>/dev/null && echo "utils.ts found") || echo "utils.ts not found"

# Build the application
RUN npx vite build --config vite.config.ts

# Production stage with nginx
FROM nginx:alpine

# Copy built application
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
